generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All enum-like fields use String with application-level validation (Zod).
// Valid values are documented in comments and enforced by Zod schemas.

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  globalRole   String          @default("STANDARD_USER") // "SUPER_ADMIN" | "ADMIN" | "SUPER_USER" | "STANDARD_USER"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  ProjectMember[]
  projects     Project[]       @relation("CreatedBy")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  baseUrl        String?
  color          String   @default("#22d3ee")
  reqLibraryPath String?
  videoEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  creator        User     @relation("CreatedBy", fields: [createdBy], references: [id])

  members              ProjectMember[]
  envConfigs           EnvConfig[]
  testCases            TestCase[]
  scripts              Script[]
  runs                 Run[]
  schedules            Schedule[]
  suites               Suite[]
  reports              Report[]
  resources            ProjectResource[]
  tcItems              TcItem[]
  testCycles           TestCycle[]
  jiraIssues           JiraIssue[]
  jiraConfig           JiraConfig?
  testCycleItems       TestCycleItem[]
  testCycleItemHistory TestCycleItemHistory[]

  @@index([createdBy])
}

model ProjectMember {
  id                   String                 @id @default(cuid())
  projectId            String
  userId               String
  role                 String                 @default("SUPER_USER") // "ADMIN" | "SUPER_USER" | "STANDARD_USER" | "TEST_USER"
  createdAt            DateTime               @default(now())
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedItems        TestCycleItem[]
  testCycleItemHistory TestCycleItemHistory[]

  @@unique([projectId, userId])
  @@index([userId])
}

model EnvConfig {
  id        String   @id @default(cuid())
  projectId String
  name      String
  baseUrl   String
  username  String?
  password  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCase {
  id               String      @id @default(cuid())
  projectId        String
  tcId             String
  title            String
  description      String?
  steps            String      @default("[]")
  expectedResult   String
  type             String      @default("UI") // "UI" | "API" | "SIT"
  tags             String      @default("[]")
  useCaseTag       String?
  status           String      @default("DRAFT") // "DRAFT" | "APPROVED" | "DEPRECATED"
  priority         String      @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  sourceRef        String?
  generationHints  String?
  prerequisiteTcId String?
  prerequisiteTc   TestCase?   @relation("PrerequisiteOf", fields: [prerequisiteTcId], references: [id], onDelete: SetNull)
  dependentTcs     TestCase[]  @relation("PrerequisiteOf")
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scripts          Script[]
  runResults       RunResult[]
  tcItems          TcItem[]

  @@unique([projectId, tcId])
  @@index([projectId])
  @@index([projectId, useCaseTag])
  @@index([projectId, status])
  @@index([projectId, type])
}

model Script {
  id             String      @id @default(cuid())
  projectId      String
  testCaseId     String?
  filename       String
  content        String
  scriptType     String      @default("ROBOT") // "ROBOT"
  isCustomUpload Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase       TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  runResults     RunResult[]

  @@unique([projectId, filename])
  @@index([projectId])
  @@index([testCaseId])
}

model Run {
  id              String      @id @default(cuid())
  projectId       String
  runSeq          Int         @default(0) // global auto-increment assigned at creation
  name            String
  environment     String
  status          String      @default("PENDING") // "PENDING" | "RUNNING" | "PASSED" | "FAILED" | "CANCELLED"
  startedAt       DateTime?
  completedAt     DateTime?
  triggerType     String      @default("MANUAL") // "MANUAL" | "SCHEDULED" | "INDIVIDUAL" | "GROUP"
  createdAt       DateTime    @default(now())
  createdByUserId String?
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results         RunResult[]
  report          Report?

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([createdByUserId])
}

model RunResult {
  id             String   @id @default(cuid())
  runId          String
  testCaseId     String
  scriptId       String?
  status         String // "PENDING" | "RUNNING" | "PASSED" | "FAILED" | "CANCELLED" | "SKIPPED"
  duration       Int?
  errorMessage   String?
  screenshotPath String?
  videoPath      String?
  rfReportPath   String?
  rfLogPath      String?
  createdAt      DateTime @default(now())
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  script         Script?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@unique([runId, testCaseId])
  @@index([runId])
  @@index([testCaseId])
  @@index([scriptId])
}

model Schedule {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  cronExpression  String
  testCaseIds     String   @default("[]")
  environment     String
  isActive        Boolean  @default(true)
  record          Boolean  @default(true)
  emailRecipients String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, isActive])
}

model Suite {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  testCaseIds String   @default("[]") // JSON: string[] (legacy, kept for migration)
  stages      String   @default("[]") // JSON: { useCaseTag: string; mode: 'sequential'|'parallel' }[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Report {
  id          String    @id @default(cuid())
  projectId   String
  runId       String    @unique
  summary     String
  aiAnalysis  String
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectResource {
  id           String   @id @default(cuid())
  projectId    String
  filename     String
  originalName String
  size         Int
  uploadedAt   DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filename])
  @@index([projectId])
}

// ── TC Library — requirement-level test cases imported from Excel ───────────
model TcItem {
  id               String          @id @default(cuid())
  projectId        String
  srNo             String? // stored as-is from Excel (supports AIR-TC-001 style IDs)
  module           String?
  feature          String?
  title            String
  description      String?
  steps            String? // raw text from Excel "Step" column
  expectedResult   String?
  linkedScriptId   String? // FK to TestCase (Script Library entry)
  automationStatus String          @default("IN_SCOPE") // "IN_SCOPE" | "NOT_APPLICABLE"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedScript     TestCase?       @relation(fields: [linkedScriptId], references: [id], onDelete: SetNull)
  testCycleItems   TestCycleItem[]

  @@index([projectId])
  @@index([linkedScriptId])
  @@index([projectId, automationStatus])
}

// ── Test Management — manual test cycles, assignment, Jira linking ──────────
// Deliberately separate from the automation `Suite` model, which drives
// Robot Framework execution ordering. A TestCycle is a human-run regression
// pass: it snapshots a set of TcItems (the real test cases, TC Library) at
// creation time (no live re-sync), each item assigned to a ProjectMember who
// records a manual result. Pure manual test management — not linked to the
// automation Script/TestCase model or TcItem.linkedScriptId at all right now.

model TestCycle {
  id                String          @id @default(cuid())
  projectId         String
  name              String
  description       String?
  status            String          @default("PLANNING") // "PLANNING" | "ACTIVE" | "CLOSED"
  linkedJiraKeys    String          @default("[]") // JSON: string[] — cycle-level Jira links
  jiraLabels        String          @default("[]") // JSON: string[] — opco/team label(s) used to auto-discover bugs in this cycle's window (same Jira project, distinguished by label, not project key)
  jiraJql           String? // raw JQL, additive alongside jiraLabels — lets an admin hand-tune bug discovery per cycle when label matching isn't precise enough
  jqlDiscoveredKeys String          @default("[]") // JSON: string[] — cache of issue keys matched by jiraJql on the last sync (mirrors how label matches are re-derived from the JiraIssue cache, since JQL matches can't be re-derived from cached fields alone)
  driveFolderUrl    String? // lead-provided link to a Google Drive folder where testers upload execution artifacts (screenshots/logs), organized into TC-ID-named subfolders by convention — not app-enforced
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  closedAt          DateTime?
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             TestCycleItem[]

  @@index([projectId])
  @@index([projectId, status])
}

model TestCycleItem {
  id                  String                 @id @default(cuid())
  projectId           String
  testCycleId         String
  testCaseId          String // FK -> TcItem.id — the REAL test case (TC Library), never the Script/TestCase model
  assigneeId          String? // FK -> ProjectMember.id
  manualStatus        String                 @default("NOT_RUN") // "NOT_RUN" | "IN_PROGRESS" | "PASS" | "FAIL" | "BLOCKED"
  reason              String? // required (Zod) when manualStatus is FAIL/BLOCKED
  jiraIssueKeys       String                 @default("[]") // JSON: string[] — multiple bugs per result
  lastUpdatedByUserId String?
  lastUpdatedAt       DateTime?
  sortOrder           Int                    @default(0)
  createdAt           DateTime               @default(now())
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCycle           TestCycle              @relation(fields: [testCycleId], references: [id], onDelete: Cascade)
  testCase            TcItem                 @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  assignee            ProjectMember?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  history             TestCycleItemHistory[]

  @@unique([testCycleId, testCaseId])
  @@index([testCycleId])
  @@index([testCaseId])
  @@index([assigneeId])
}

// Append-only audit trail of every manual status transition — powers the
// resource-wise daily trend dashboard. Denormalizes projectId/testCycleId/
// testCaseId/assigneeId (as they stood at the moment of the change) so the
// dashboard queries don't need to join back through TestCycleItem for
// filtering, and so history remains meaningful even if the item is later
// reassigned or the cycle is deleted out from under it in the future.
model TestCycleItemHistory {
  id              String         @id @default(cuid())
  projectId       String
  testCycleId     String
  testCycleItemId String
  testCaseId      String
  assigneeId      String? // who was assigned at the moment of this change
  fromStatus      String
  toStatus        String
  reason          String?
  jiraIssueKeys   String         @default("[]")
  changedByUserId String
  changedAt       DateTime       @default(now())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCycleItem   TestCycleItem  @relation(fields: [testCycleItemId], references: [id], onDelete: Cascade)
  assignee        ProjectMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, changedAt])
  @@index([testCycleId])
  @@index([testCycleItemId])
  @@index([assigneeId])
}

// Locally cached Jira issue snapshot, refreshed by the poll worker
// (packages/api/src/jobs/jiraPollWorker.ts) — never fetched live on page
// render, so a "bugs linked to this cycle" view doesn't fire N live Jira
// calls per page load.
model JiraIssue {
  id             String    @id @default(cuid())
  projectId      String
  issueKey       String
  summary        String?
  status         String?
  statusCategory String? // "new" | "indeterminate" | "done" — Jira's workflow-agnostic bucket, used to detect "resolved" reliably across custom status names
  issueType      String?
  priorityName   String?
  labels         String    @default("[]") // JSON: string[] — matched against TestCycle.jiraLabels for label-based discovery
  components     String    @default("[]") // JSON: string[] — Jira component name(s)
  assigneeName   String?
  reporterName   String?
  jiraCreatedAt  DateTime? // Jira's own "created" field, distinct from our lastSyncedAt/createdAt
  dueDate        DateTime?
  jiraUpdatedAt  DateTime?
  lastSyncedAt   DateTime  @default(now())
  syncError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueKey])
  @@index([projectId])
}

// One row per project — per-project *settings* only. Credentials are NOT
// stored here: JIRA_HOST/JIRA_EMAIL/JIRA_API_TOKEN already exist as global
// env vars (see .env.example, originally documented for a never-built
// "Writer Agent" feature) — reusing that single-Jira-tenant convention
// instead of inventing a second, per-project encrypted-secret store.
model JiraConfig {
  id                  String    @id @default(cuid())
  projectId           String    @unique
  jiraProjectKey      String? // filters which issues are "relevant" to this project
  pollIntervalMinutes Int       @default(5)
  isEnabled           Boolean   @default(false)
  lastPollAt          DateTime?
  lastPollStatus      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
